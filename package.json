{
  "name": "uk-immigration-simulator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "deploy:pages": "pnpm build && pnpm dlx wrangler@4.157.0 pages deploy apps/web/out --project-name \"${CF_PAGES_PROJECT:?set CF_PAGES_PROJECT}\"",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
